
@model List<SistemaGestionEventos.Models.TipoEntrada>
@using System.Collections.Generic

@{
    ViewBag.Title = "Tipos de entrada";

    var nombresEventos = ViewBag.NombresEventos
        as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="ef-page">

    <div class="ef-header">
        <div>
            <h2>Tipos de Entrada</h2>
            <p>Administra las categorías disponibles para cada evento.</p>
        </div>

        @Html.ActionLink("Nueva categoría",
            "Crear", "TiposEntrada", null,
            new { @class = "ef-btn ef-btn-primary" })
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">
            @TempData["MensajeExito"]
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["MensajeError"]
        </div>
    }

    @if (ViewBag.MensajeError != null)
    {
        <div class="alert alert-danger">
            @ViewBag.MensajeError
        </div>
    }

    <div class="ef-card">

        <h4>Categorías registradas</h4>

        <p class="ef-muted" style="margin-bottom:20px;">
            Total de categorías:
            <strong>@(Model != null ? Model.Count : 0)</strong>
        </p>

        <div class="table-responsive">

            <table class="table ef-table">
                <thead>
                    <tr>
                        <th>Tipo de entrada</th>
                        <th>Evento</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var tipo in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@tipo.Nombre</strong>
                                </td>

                                <td>
                                    @(nombresEventos.ContainsKey(tipo.EventoId)
                                        ? nombresEventos[tipo.EventoId]
                                        : "Evento no disponible")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(tipo.Descripcion)
                                        ? "Sin descripción"
                                        : tipo.Descripcion)
                                </td>

                                <td>
                                    <div class="ef-actions">

                                        @Html.ActionLink("Detalles",
                                            "Detalles",
                                            new { id = tipo.Id },
                                            new
                                                 {
                                                @class = "ef-btn ef-btn-soft ef-btn-sm"
                                            })

                                        @Html.ActionLink("Editar",
                                            "Editar",
                                            new { id = tipo.Id },
                                            new
                                                 {
                                                @class = "ef-btn ef-btn-secondary ef-btn-sm"
                                            })

                                        @Html.ActionLink("Eliminar",
                                            "Eliminar",
                                            new { id = tipo.Id },
                                            new
                                                 {
                                                @class = "ef-btn ef-btn-danger ef-btn-sm"
                                            })

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                <div style="padding:35px;">
                                    <h4>No hay categorías registradas</h4>
                                    <p class="ef-muted">
                                        Crea una categoría para comenzar.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
