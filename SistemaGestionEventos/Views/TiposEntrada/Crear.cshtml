
@model SistemaGestionEventos.Models.TipoEntrada
@using System.Web.Mvc

@{
    ViewBag.Title = "Nueva categoría";
}

<div class="ef-page">

    <div class="ef-header">
        <div>
            <h2>Registrar tipo de entrada</h2>
            <p>Asigna una categoría a un evento disponible.</p>
        </div>
    </div>

    <div class="ef-card ef-form-card">

        @using (Html.BeginForm("Crear", "TiposEntrada",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "",
                new { @class = "text-danger" })

            <div class="row">

                <div class="col-md-12 ef-field">

                    @Html.LabelFor(m => m.EventoId,
                        new { @class = "form-label" })

                    @Html.DropDownListFor(
                        m => m.EventoId,
                        (SelectList)ViewBag.Eventos,
                        "Seleccione un evento",
                        new { @class = "form-control" })

                    @Html.ValidationMessageFor(m => m.EventoId,
                        "", new { @class = "text-danger" })

                </div>

                <div class="col-md-12 ef-field">

                    @Html.LabelFor(m => m.Nombre,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Nombre,
                        new
                             {
                            @class = "form-control",
                            maxlength = "100",
                            placeholder = "Ejemplo: General, VIP, Preferencial"
                        })

                    @Html.ValidationMessageFor(m => m.Nombre,
                        "", new { @class = "text-danger" })

                </div>

                <div class="col-md-12 ef-field">

                    @Html.LabelFor(m => m.Descripcion,
                        new { @class = "form-label" })

                    @Html.TextAreaFor(m => m.Descripcion,
                        new
                             {
                            @class = "form-control",
                            rows = "4",
                            maxlength = "500",
                            placeholder = "Describe los beneficios de esta categoría"
                        })

                    @Html.ValidationMessageFor(m => m.Descripcion,
                        "", new { @class = "text-danger" })

                </div>

            </div>

            <div class="ef-form-actions">

                <button type="submit"
                        class="ef-btn ef-btn-primary">
                    Guardar categoría
                </button>

                @Html.ActionLink("Cancelar", "Index",
                    "TiposEntrada", null,
                    new { @class = "ef-btn ef-btn-soft" })

            </div>
        }

    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
