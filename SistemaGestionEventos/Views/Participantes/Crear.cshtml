
@model SistemaGestionEventos.Models.Participante

@{
    ViewBag.Title = "Nuevo participante";
}

<div class="ef-page">

    <div class="ef-header">
        <div>
            <h2>Registrar participante</h2>
            <p>Completa los datos del nuevo participante.</p>
        </div>
    </div>

    <div class="ef-card ef-form-card">

        @using (Html.BeginForm("Crear", "Participantes",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(true, "",
                new { @class = "text-danger" })

            <div class="row">

                <div class="col-md-6 ef-field">

                    @Html.LabelFor(m => m.Documento,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Documento,
                        new
                             {
                            @class = "form-control",
                            maxlength = "30",
                            placeholder = "DPI o identificación"
                        })

                    @Html.ValidationMessageFor(m => m.Documento,
                        "", new { @class = "text-danger" })

                </div>

                <div class="col-md-6 ef-field">

                    @Html.LabelFor(m => m.NombreCompleto,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.NombreCompleto,
                        new
                             {
                            @class = "form-control",
                            maxlength = "150",
                            placeholder = "Nombre y apellidos"
                        })

                    @Html.ValidationMessageFor(m => m.NombreCompleto,
                        "", new { @class = "text-danger" })

                </div>

                <div class="col-md-6 ef-field">

                    @Html.LabelFor(m => m.Correo,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Correo,
                        new
                             {
                            @class = "form-control",
                            type = "email",
                            maxlength = "150",
                            placeholder = "correo@ejemplo.com"
                        })

                    @Html.ValidationMessageFor(m => m.Correo,
                        "", new { @class = "text-danger" })

                </div>

                <div class="col-md-6 ef-field">

                    @Html.LabelFor(m => m.Telefono,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Telefono,
                        new
                             {
                            @class = "form-control",
                            type = "tel",
                            maxlength = "25",
                            placeholder = "Número de contacto"
                        })

                    @Html.ValidationMessageFor(m => m.Telefono,
                        "", new { @class = "text-danger" })

                </div>

            </div>

            <div class="ef-form-actions">

                <button type="submit"
                        class="ef-btn ef-btn-primary">
                    Guardar participante
                </button>

                @Html.ActionLink("Cancelar", "Index",
                    "Participantes", null,
                    new { @class = "ef-btn ef-btn-soft" })

            </div>
        }

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
