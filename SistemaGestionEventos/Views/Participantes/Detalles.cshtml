
@model SistemaGestionEventos.Models.Participante

@{
    ViewBag.Title = "Detalles del participante";
}

<div class="ef-page">

    <div class="ef-header">
        <div>
            <h2>Detalles del participante</h2>
            <p>Información del participante registrado.</p>
        </div>
    </div>

    <div class="ef-card ef-form-card">

        <h4>@Model.NombreCompleto</h4>

        <table class="table ef-table">
            <tbody>

                <tr>
                    <th>Identificador</th>
                    <td>@Model.Id</td>
                </tr>

                <tr>
                    <th>Documento</th>
                    <td>@Model.Documento</td>
                </tr>

                <tr>
                    <th>Nombre completo</th>
                    <td>@Model.NombreCompleto</td>
                </tr>

                <tr>
                    <th>Correo electrónico</th>
                    <td>
                        @(string.IsNullOrWhiteSpace(Model.Correo)
                            ? "No registrado"
                            : Model.Correo)
                    </td>
                </tr>

                <tr>
                    <th>Teléfono</th>
                    <td>
                        @(string.IsNullOrWhiteSpace(Model.Telefono)
                            ? "No registrado"
                            : Model.Telefono)
                    </td>
                </tr>

            </tbody>
        </table>

        <div class="ef-form-actions">

            @Html.ActionLink("Editar participante",
                "Editar", "Participantes",
                new { id = Model.Id },
                new { @class = "ef-btn ef-btn-secondary" })

            @Html.ActionLink("Volver al listado",
                "Index", "Participantes", null,
                new { @class = "ef-btn ef-btn-soft" })

        </div>

    </div>

</div>
