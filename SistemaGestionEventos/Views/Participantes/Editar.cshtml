
@model SistemaGestionEventos.Models.Participante

@{
    ViewBag.Title = "Editar participante";
}

<div class="ef-page">

    <div class="ef-header">
        <div>
            <h2>Editar participante</h2>
            <p>Actualiza la información del participante.</p>
        </div>
    </div>

    <div class="ef-card ef-form-card">

        @using (Html.BeginForm("Editar", "Participantes",
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)

            @Html.ValidationSummary(true, "",
                new { @class = "text-danger" })

            <div class="row">

                <div class="col-md-6 ef-field">

                    @Html.LabelFor(m => m.Documento,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Documento,
                        new
                             {
                            @class = "form-control",
                            maxlength = "30"
                        })

                    @Html.ValidationMessageFor(m => m.Documento,
                        "", new { @class = "text-danger" })

                </div>

                <div class="col-md-6 ef-field">

                    @Html.LabelFor(m => m.NombreCompleto,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.NombreCompleto,
                        new
                             {
                            @class = "form-control",
                            maxlength = "150"
                        })

                    @Html.ValidationMessageFor(m => m.NombreCompleto,
                        "", new { @class = "text-danger" })

                </div>

                <div class="col-md-6 ef-field">

                    @Html.LabelFor(m => m.Correo,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Correo,
                        new
                             {
                            @class = "form-control",
                            type = "email",
                            maxlength = "150"
                        })

                    @Html.ValidationMessageFor(m => m.Correo,
                        "", new { @class = "text-danger" })

                </div>

                <div class="col-md-6 ef-field">

                    @Html.LabelFor(m => m.Telefono,
                        new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Telefono,
                        new
                             {
                            @class = "form-control",
                            type = "tel",
                            maxlength = "25"
                        })

                    @Html.ValidationMessageFor(m => m.Telefono,
                        "", new { @class = "text-danger" })

                </div>

            </div>

            <div class="ef-form-actions">

                <button type="submit"
                        class="ef-btn ef-btn-primary">
                    Guardar cambios
                </button>

                @Html.ActionLink("Cancelar", "Index",
                    "Participantes", null,
                    new { @class = "ef-btn ef-btn-soft" })

            </div>
        }

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
